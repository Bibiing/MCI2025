   "source": [
    "#### Handling Outliers  \n",
    "[sumber baca](https://medium.com/@vineet.pandya/test-of-normality-box-cox-transformation-in-details-c4bdfc2c352a)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 757
    },
    "id": "QfY7-FHQTN2_",
    "outputId": "e50a4c0e-0bdb-45f1-b7f6-6fc2acf74d26"
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x1000 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(15, 10))\n",
    "df_knn.boxplot()\n",
    "plt.title('Identifikasi Outliers')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "metadata": {
    "id": "kk2b9uAqjMj1"
   },
   "outputs": [],
   "source": [
    "df_processed = df_knn.copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {
    "id": "QK-Nyvx3oB74"
   },
   "outputs": [],
   "source": [
    "columns = ['Insulin', 'DiabetesPedigreeFunction', 'Age', 'Pregnancies', 'Glucose', 'BloodPressure', 'SkinThickness', 'BMI']\n",
    "\n",
    "for col in columns:\n",
    "    Q1 = df_processed[col].quantile(0.25)\n",
    "    Q3 = df_processed[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "\n",
    "    lower_bound = Q1 - 1.5 * IQR\n",
    "    upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "    df_processed.loc[df_processed[col] < lower_bound, col] = lower_bound\n",
    "    df_processed.loc[df_processed[col] > upper_bound, col] = upper_bound"
   ]
  },
